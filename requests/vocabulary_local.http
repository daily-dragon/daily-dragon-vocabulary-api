### Get all words
GET http://127.0.0.1:8000/daily-dragon/vocabulary
Authorization: Bearer <token>

### Get random words
GET http://127.0.0.1:8000/daily-dragon/vocabulary?count=5
Authorization: Bearer <token>

###
OPTIONS http://127.0.0.1:8000/daily-dragon/vocabulary

### Add a new word
POST http://127.0.0.1:8000/daily-dragon/vocabulary
Authorization: Bearer <token>

{
    "word": "你好"
}

### Delete a word
# use tools/encode.py to encode Chinese characters
DELETE http://127.0.0.1:8000/daily-dragon/vocabulary/%E4%BD%A0%E5%A5%BD
Authorization: Bearer <token>

### Get due words for review (spaced repetition)
GET http://127.0.0.1:8000/daily-dragon/vocabulary/due
Authorization: Bearer <token>

### Submit batch reviews with quality ratings (spaced repetition)
# Quality ratings: 0 (blackout) to 5 (perfect recall)
POST http://127.0.0.1:8000/daily-dragon/vocabulary/reviews
Authorization: Bearer <token>
Content-Type: application/json

{
  "reviews": [
    {"word": "你好", "quality": 5},
    {"word": "学习", "quality": 4},
    {"word": "中文", "quality": 3}
  ]
}
